# BrandGuard AI Environment Configuration

# Backend
SECRET_KEY=brandguard-enterprise-jwt-signing-key-2026-production
ENVIRONMENT=development
# For PostgreSQL (production or local Docker):
# DATABASE_URL=postgresql://brandguard:brandguard_password@localhost:5432/brandguard_db
# SQLite fallback (default out-of-the-box):
DATABASE_URL=sqlite:///./brandguard.db

# AI Engine Provider ('rule_fallback', 'openai', 'gemini')
AI_PROVIDER=rule_fallback
OPENAI_API_KEY=
GEMINI_API_KEY=

# Enterprise Security & MFA
MFA_ENFORCE_ADMIN=false

# ─── Email Delivery ────────────────────────────────────────────────────────
# OPTION A: Resend HTTP API (RECOMMENDED for Render — bypasses SMTP port firewall)
#   1. Sign up free at https://resend.com (100 emails/day free tier)
#   2. Create an API key at https://resend.com/api-keys
#   3. Add your verified sending domain OR use onboarding@resend.dev for testing
#   When RESEND_API_KEY is set, SMTP settings below are ignored.
RESEND_API_KEY=
SMTP_FROM_EMAIL=noreply@brandguard.ai
SMTP_FROM_NAME=BrandGuard AI Security
FRONTEND_URL=http://localhost:3000

# OPTION B: SMTP (use only if Resend is not configured)
#   NOTE: Render.com blocks outbound SMTP ports (25, 465, 587).
#   SMTP works on local dev and VPS deployments.
#   Leave all SMTP_* blank in development for console logging fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

