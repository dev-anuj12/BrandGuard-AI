# BrandGuard AI Environment Configuration

# Backend
SECRET_KEY=brandguard-enterprise-jwt-signing-key-2026-production
ENVIRONMENT=development
# For PostgreSQL (production or local Docker):
# DATABASE_URL=postgresql://brandguard:brandguard_password@localhost:5432/brandguard_db
# SQLite fallback (default out-of-the-box):
DATABASE_URL=sqlite:///./brandguard.db

# AI Engine Provider ('rule_fallback', 'openai', 'gemini')
AI_PROVIDER=rule_fallback
OPENAI_API_KEY=
GEMINI_API_KEY=

# Enterprise Security & MFA
MFA_ENFORCE_ADMIN=false

# ─── Email Delivery ────────────────────────────────────────────────────────
# OPTION A: EmailJS REST API (RECOMMENDED for Render — uses HTTPS port 443)
#   1. Sign up at https://www.emailjs.com/
#   2. Add an Email Service (e.g. Gmail, Outlook, SMTP) -> EMAILJS_SERVICE_ID
#   3. Create an Email Template -> EMAILJS_TEMPLATE_ID
#      Template variables: {{to_email}}, {{to_name}}, {{otp}}
#   4. Under Account -> API Keys:
#      Public Key  -> EMAILJS_PUBLIC_KEY
#      Private Key -> EMAILJS_PRIVATE_KEY
#   When EMAILJS_* keys are set, SMTP settings below are bypassed.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
FRONTEND_URL=http://localhost:3000

# OPTION B: SMTP (fallback if EmailJS is not configured)
#   NOTE: Render.com blocks outbound SMTP ports (25, 465, 587).
#   SMTP works on local dev and VPS deployments.
#   Leave all settings blank in development for console logging fallback.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@brandguard.ai
SMTP_FROM_NAME=BrandGuard AI Security
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

