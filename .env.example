# BrandGuard AI Environment Configuration

# Backend
SECRET_KEY=brandguard-enterprise-jwt-signing-key-2026-production
ENVIRONMENT=development
# For PostgreSQL (production or local Docker):
# DATABASE_URL=postgresql://brandguard:brandguard_password@localhost:5432/brandguard_db
# SQLite fallback (default out-of-the-box):
DATABASE_URL=sqlite:///./brandguard.db

# AI Engine Provider ('rule_fallback', 'openai', 'gemini')
AI_PROVIDER=rule_fallback
OPENAI_API_KEY=
GEMINI_API_KEY=

# Enterprise Security & MFA
MFA_ENFORCE_ADMIN=false

# SMTP Email Delivery (OTP verification & password recovery)
# Leave blank to use secure internal development logging fallback
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@brandguard.ai
SMTP_FROM_NAME=BrandGuard AI Security
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

